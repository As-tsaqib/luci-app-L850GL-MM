{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fibocom/profile-v1.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 As Tsaqib; SPDX-License-Identifier: Apache-2.0",
  "title": "Fibocom modem profile version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "display_name",
    "match",
    "management_backend",
    "bearer_backends",
    "ports",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models_exact", "usb"],
      "properties": {
        "manufacturer": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "models_exact": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "usb": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vid", "pid", "composition"],
            "properties": {
              "vid": {
                "type": "string",
                "pattern": "^[0-9a-f]{4}$"
              },
              "pid": {
                "type": "string",
                "pattern": "^[0-9a-f]{4}$"
              },
              "composition": {
                "enum": ["mbim", "ncm"]
              }
            }
          }
        }
      }
    },
    "management_backend": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "bearer_backends": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
      },
      "propertyNames": {
        "enum": ["mbim", "ncm"]
      },
      "minProperties": 1
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mbim": {
          "$ref": "#/$defs/portMap"
        },
        "ncm": {
          "$ref": "#/$defs/portMap"
        }
      },
      "minProperties": 1
    },
    "ncm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_cid"],
      "properties": {
        "session_cid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "supported",
          "planned",
          "mbim-only-planned",
          "hardware-validation-required",
          "probe-required",
          "experimental-disabled",
          "unavailable"
        ]
      }
    }
  },
  "$defs": {
    "interfaceNumber": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}$"
    },
    "portMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at_primary": {
          "$ref": "#/$defs/interfaceNumber"
        },
        "at_secondary": {
          "$ref": "#/$defs/interfaceNumber"
        },
        "ignored": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/interfaceNumber"
          }
        },
        "data_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/interfaceNumber"
          }
        },
        "data_selector": {
          "enum": ["exact-interface-parent", "hardware-required"]
        }
      },
      "required": ["at_primary", "ignored"]
    }
  }
}
